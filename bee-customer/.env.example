# API Configuration (base URL only; do NOT include /api or trailing slash)
EXPO_PUBLIC_API_URL=https://api.mybeeapp.com
EXPO_PUBLIC_API_TIMEOUT=1000
EXPO_PUBLIC_API_DEBUG=false

# One-time post-KYC welcome screen (app/welcome.tsx).
# true  = verified users see the "Welcome to the Hive" screen once, then straight into the app tabs
# false = verified users skip it and go straight into the app tabs every time
# Unset defaults to true. Restart the bundler with -c after changing.
EXPO_PUBLIC_WELCOME_SCREEN_ENABLED=true

# Clerk (auth). Leave empty to keep Clerk DISABLED (app uses the legacy auth).
# Set the Clerk Publishable Key to enable Clerk. Get it from the Clerk Dashboard → API Keys.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google Maps API Configuration
# Replace 'your_api_key_here' with your actual Google Maps API key from Google Cloud Console
# See docs/plans/google-maps-integration-plan.md for setup instructions
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAl8YvG-k2gOW86s0MtirD4guXzk9hChZQ
# Google Maps API Base URL (optional - defaults to https://maps.googleapis.com/maps/api)
# Only change this if you need to use a different API endpoint (e.g., proxy, custom domain)
EXPO_PUBLIC_GOOGLE_MAPS_API_BASE_URL=https://maps.googleapis.com/maps/api

# Map provider: when unset, app defaults to mapbox. Set to google to use Google for directions/geocoding/search.
# EXPO_PUBLIC_MAP_PROVIDER=mapbox
# EXPO_PUBLIC_MAP_PROVIDER=google

# Mapbox – public access token (for map provider when EXPO_PUBLIC_MAP_PROVIDER=mapbox)
# Optional env-specific: EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN_DEVELOPMENT, _STAGING, _PRODUCTION
# See docs/plans/mapbox-migration-plan.md and docs/ENVIRONMENT_VARIABLES.md
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Sentry / GlitchTip error & crash reporting (self-hosted, Sentry-protocol compatible)
# Single DSN for all environments — segmented by the "environment" tag (see getEnvironment() in app.config.js).
EXPO_PUBLIC_SENTRY_DSN=https://a61a8d195e134320a414671daf843c9b@glitchtip.ilocosscript.live/2
